FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends git tar xz-utils curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# stalwart-cli
ARG STALWART_CLI_VERSION=1.0.14
RUN curl --proto '=https' --tlsv1.2 -LsSf "https://github.com/stalwartlabs/cli/releases/download/v${STALWART_CLI_VERSION}/stalwart-cli-installer.sh" | UNMANAGED_INSTALL=/usr/local/bin sh

# just
ARG JUST_VERSION=1.59.0
RUN curl --proto '=https' --tlsv1.2 -LsSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin --tag "${JUST_VERSION}"